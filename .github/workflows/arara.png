name: Commit

on:
  workflow_dispatch:
  push:
    branches:
      - unkobriri

permissions:
  contents: write

jobs:
  commit:
    runs-on: ubuntu-latest

    env:
      GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          fetch-depth: 0

      - name: Extract ZIP
        shell: bash
        run: |
          set -euo pipefail

          ZIP="$(find . -maxdepth 1 -type f -name '*.zip' -print -quit)"

          if [ -z "$ZIP" ]; then
            echo "ZIP file not found."
            exit 1
          fi

          mkdir -p extracted
          unzip -oq "$ZIP" -d extracted

          shopt -s dotglob nullglob
          items=(extracted/*)

          if [ "${#items[@]}" -eq 1 ] && [ -d "${items[0]}" ]; then
            cp -a "${items[0]}"/. ./
          else
            cp -a extracted/. ./
          fi

          rm -rf extracted
          rm -f "$ZIP"

      - name: Commit
        shell: bash
        run: |
          set -euo pipefail

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add -A

          if git diff --cached --quiet; then
            echo "No changes to commit."
            exit 0
          fi

          git commit -m "Import Sakalti Hephaestus 1.20.1 project"
          git push origin HEAD:unkobriri
